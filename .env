# ---- ChipCity configuration -------------------------------------------------
# Copy to .env and fill in. Never commit the real .env.

# BotFather token
BOT_TOKEN=8496628669:AAG9t8nFCcKuAqpoEkt8cs2f_Ip2Q5Sq6i4

# Your own numeric Telegram ID (send /start to @userinfobot). Only this ID may
# create chips or run admin commands.
OWNER_TELEGRAM_ID=123456789

# SQLite for local dev, PostgreSQL for production.
# Railway/Heroku-style postgres:// and postgresql:// URLs are normalized automatically.
# Owner (set in Railway vars or .env):
OWNER_TELEGRAM_ID=1857417752
OWNER_TELEGRAM_USERNAME=krisnn_ka_bhakt
DATABASE_URL=sqlite+aiosqlite:///./data/chipcity.db
# DATABASE_URL=postgresql+asyncpg://chipcity:chipcity@db:5432/chipcity

# Optional. Leave empty to use the in-process fallback (single instance only).
REDIS_URL=
# REDIS_URL=redis://redis:6379/0

# polling (dev) or webhook (prod)
MODE=polling
WEBHOOK_URL=
WEBHOOK_SECRET=change-me-please
# Railway sets PORT for web services; WEB_PORT takes precedence when both exist.
WEB_HOST=0.0.0.0
WEB_PORT=8080

# Money is always stored in integer cents; these values are in whole chips.
DEFAULT_HOUSE_EDGE=0.01
MIN_BET=1
MAX_BET=100000
MAX_PROFIT_PER_BET=1000000
STARTING_BALANCE=0

# Multi-step rounds are auto-cashed-out (or forfeited) after this many seconds.
SESSION_TIMEOUT_SECONDS=600

# Anti-flood: bets per second per user.
BETS_PER_SECOND=3

# Render Pillow board images (disable on very small hosts).
RENDER_IMAGES=true

LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
